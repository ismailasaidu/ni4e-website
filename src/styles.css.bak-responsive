/* =========================================================
   FINAL RESPONSIVE + MOBILE INPUT ZOOM FIX
   ========================================================= */
html{-webkit-text-size-adjust:100%;text-size-adjust:100%;overflow-x:hidden}
body{width:100%;min-width:0;overflow-x:hidden}
img,svg,video,canvas{max-width:100%}
button,input,select,textarea{max-width:100%;-webkit-tap-highlight-color:transparent}
/* iOS Safari zooms focused controls when their text is below 16px. */
input,select,textarea{font-size:16px!important;line-height:1.4;min-height:48px}
input[type="checkbox"],input[type="radio"]{width:18px!important;min-width:18px!important;height:18px!important;min-height:18px!important;padding:0!important;flex:0 0 18px}
input[type="file"]{font-size:16px!important}
label{min-width:0}
.formGrid>label,.formGrid label{min-width:0}
.passwordField{position:relative}
.passwordField input{padding-right:52px}
.passwordField>button{position:absolute;right:8px;bottom:6px;width:38px;height:36px;display:grid;place-items:center;color:var(--muted);z-index:2}

